# Copy to .env for local dev, or .env.production before `npm run build`
# for a real deployment.

# Leave blank during local dev — vite.config.js already proxies /api and
# /media to http://127.0.0.1:8000 for you.
# For production, set this to your deployed Django API's full URL, e.g.:
#   VITE_API_BASE_URL=https://api.yourtordi.com
VITE_API_BASE_URL=
