# Copy this file to `.env` and fill in your real values.
# `.env` itself is listed in .gitignore — never commit it.

# --- Required for production -------------------------------------------
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=yourdomain.com

# --- CORS -------------------------------------------------------------------
# Your deployed frontend's URL(s), comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email is OPTIONAL now -------------------------------------------------
# Login/registration use phone number + password, not email — nothing
# below is required for the app to work. It's only here in case you add
# email-based features later (receipts, notifications, etc).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tordi <no-reply@tordi.app>
